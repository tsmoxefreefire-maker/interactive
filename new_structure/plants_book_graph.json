  "node_content": [
    {
      "node_id": "root",
      "content_type": "text",
      "content_url": null,
      "content_text": "الجزء تحت الأرض؛ يثبّت النبتة ويمتص الماء والأملاح من التربة."
    },
    {
      "node_id": "stem",
      "content_type": "text",
      "content_url": null,
      "content_text": "يحمل النبتة وينقل الماء من الجذر إلى الأوراق والغذاء من الأوراق لباقي النبتة."
    },
    {
      "node_id": "leaf",
      "content_type": "text",
      "content_url": null,
      "content_text": "جزء أخضر مسطّح يصنع فيه النبات غذاءه من ضوء الشمس والماء والهواء."
    },
    {
      "node_id": "flower",
      "content_type": "text",
      "content_url": null,
      "content_text": "جزء مسؤول عن التكاثر، ويتحوّل إلى ثمرة بعد التلقيح."
    },
    {
      "node_id": "fruit",
      "content_type": "text",
      "content_url": null,
      "content_text": "تنمو من الزهرة وتحمي البذور التي بداخلها."
    },
    {
      "node_id": "seed",
      "content_type": "text",
      "content_url": null,
      "content_text": "توجد داخل الثمرة، ويمكن أن تنمو لتصبح نبتة جديدة."
    },
    {
      "node_id": "water",
      "content_type": "text",
      "content_url": null,
      "content_text": "يمتصه الجذر وينقله الساق، ويحتاجه النبات ليصنع غذاءه."
    },
    {
      "node_id": "sunlight",
      "content_type": "text",
      "content_url": null,
      "content_text": "تستخدمه الورقة لصنع الغذاء؛ بدونه يضعف النبات ويصفرّ."
    },
    {
      "node_id": "air",
      "content_type": "text",
      "content_url": null,
      "content_text": "يأخذ النبات منه غازاً يحتاجه لصنع الغذاء."
    },
    {
      "node_id": "soil",
      "content_type": "text",
      "content_url": null,
      "content_text": "تثبّت الجذر وتعطيه الماء والأملاح."
    },
    {
      "node_id": "germination",
      "content_type": "text",
      "content_url": null,
      "content_text": "أول مرحلة: تمتص البذرة الماء فيخرج منها جذر وساق صغيران."
    },
    {
      "node_id": "pollination",
      "content_type": "text",
      "content_url": null,
      "content_text": "انتقال حبوب اللقاح بين الأزهار بمساعدة الحشرات أو الرياح."
    },
    {
      "node_id": "seed_dispersal",
      "content_type": "text",
      "content_url": null,
      "content_text": "انتقال البذور بعيداً عن النبتة الأم بالرياح أو الحيوانات أو الماء."
    }
  ]
}