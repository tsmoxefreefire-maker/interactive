  "node_content": [
    {
      "node_id": "numbers",
      "content_type": "text",
      "content_text": "رموز نعدّ بها الأشياء؛ تتكوّن من آحاد وعشرات ومئات",
      "content_url": null
    },
    {
      "node_id": "addition",
      "content_type": "text",
      "content_text": "ضمّ عددين أو أكثر معاً؛ ينتج عنه المجموع",
      "content_url": null
    },
    {
      "node_id": "subtraction",
      "content_type": "text",
      "content_text": "أخذ عدد من عدد آخر؛ ينتج عنه الفرق",
      "content_url": null
    },
    {
      "node_id": "multiplication",
      "content_type": "text",
      "content_text": "جمع متكرر لنفس العدد؛ ينتج عنه حاصل الضرب",
      "content_url": null
    },
    {
      "node_id": "division",
      "content_type": "text",
      "content_text": "توزيع عدد على مجموعات متساوية؛ ينتج عنه ناتج القسمة",
      "content_url": null
    },
    {
      "node_id": "fraction",
      "content_type": "text",
      "content_text": "جزء من كلّ مقسوم إلى أجزاء متساوية؛ يُكتب بسطاً فوق مقام",
      "content_url": null
    },
    {
      "node_id": "numerator",
      "content_type": "text",
      "content_text": "العدد فوق خط الكسر؛ يدلّ على عدد الأجزاء المأخوذة",
      "content_url": null
    },
    {
      "node_id": "denominator",
      "content_type": "text",
      "content_text": "العدد تحت خط الكسر؛ يدلّ على عدد الأجزاء المتساوية للكلّ",
      "content_url": null
    },
    {
      "node_id": "equivalent",
      "content_type": "text",
      "content_text": "كسور مختلفة الشكل لها نفس القيمة؛ نحصل عليها بضرب البسط والمقام في نفس العدد",
      "content_url": null
    },
    {
      "node_id": "compare",
      "content_type": "text",
      "content_text": "معرفة أيّ الكسرين أكبر؛ نوحّد المقامات ثم نقارن البسوط",
      "content_url": null
    }
  ],
